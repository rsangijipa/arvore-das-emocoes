# ---- Firebase Web SDK (cliente) ----
# Opcional: sem estas variaveis a sessao usa um id local e os favoritos ficam
# apenas no dispositivo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (servidor) ----
# Opcional: sem estas variaveis as rotas de API caem para o catalogo local
# em data/quotes.ts e para armazenamento em memoria.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Audio ----
# "1" liga a trilha e os efeitos (precisa dos arquivos em public/audio).
NEXT_PUBLIC_ENABLE_AUDIO=0
